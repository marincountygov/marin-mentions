{
  "$schema": "vendor/marinos/filter-panel.schema.json",
  "schemaVersion": "1.0.0",
  "search": {
    "id": "filter-search"
  },
  "groups": [
    {
      "type": "select",
      "id": "time",
      "label": "Time ranges",
      "default": "60d",
      "options": {
        "values": [
          {
            "value": "24h",
            "label": "Past 24 hours"
          },
          {
            "value": "1h",
            "label": "Past hour"
          },
          {
            "value": "3d",
            "label": "Past 3 days"
          },
          {
            "value": "7d",
            "label": "Past week"
          },
          {
            "value": "30d",
            "label": "Past 30 days"
          },
          {
            "value": "60d",
            "label": "Past 60 days"
          },
          {
            "value": "all",
            "label": "All available data"
          },
          {
            "value": "report",
            "label": "Report dates",
            "hidden": true
          }
        ]
      }
    },
    {
      "type": "nested-checkbox",
      "id": "monitor",
      "label": "Subjects",
      "groupBy": [
        "facet",
        "group"
      ],
      "param": "monitors",
      "separator": ",",
      "options": {
        "app": true
      }
    },
    {
      "type": "nested-checkbox",
      "id": "source",
      "label": "Sources",
      "groupBy": [
        "type"
      ],
      "param": "sources",
      "separator": ",",
      "options": {
        "app": true
      }
    }
  ]
}
